# ============================================================
# Root .gitignore (monorepo: frontend/ + backend/)
# Frontend punya .gitignore sendiri di frontend/.gitignore
# File ini fokus ke backend Python + hal umum.
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# Packaging / build
*.egg-info/
.eggs/
dist/
build/
*.egg

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Secrets / environment ---
# JANGAN commit kredensial DB/Redis. Hanya .env.example yang boleh di-push.
.env
.env.*
!.env.example
!**/.env.example

# --- RAG vector store (Phase 5) ---
# backend/app/rag/data/ SENGAJA di-commit (115 KB): Render Free tidak punya shell
# untuk seed ulang, jadi image produksi harus membawanya. Regenerasi via
# `python -m app.rag.knowledge_base`.

# --- Local-only npm config ---
# frontend/.npmrc memakai script-shell=powershell agar `npm run ...` jalan di
# Windows ketika path project mengandung '&'/spasi. JANGAN commit — config ini
# menggagalkan `npm install` di Linux/Vercel (spawn powershell ENOENT).
frontend/.npmrc

# --- Misc ---
.DS_Store
*.log

# Phase 6: model Vestigo-TSFM 137 MB, melampaui batas 100 MB GitHub
backend/app/ml/tsfm.onnx

# Phase 6: log job harian TSFM (termasuk rotasi .log.1 .log.2)
backend/logs/
